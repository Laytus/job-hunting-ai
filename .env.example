# Database

POSTGRES_DB=job_hunting_ai
POSTGRES_USER=job_hunting_ai
POSTGRES_PASSWORD=job_hunting_ai
POSTGRES_PORT=5432

DATABASE_URL=postgresql://job_hunting_ai:job_hunting_ai@localhost:5432/job_hunting_ai
DATABASE_TEST_URL=postgresql://job_hunting_ai:job_hunting_ai@localhost:5432/job_hunting_ai_test

# API

API_HOST=localhost
API_PORT=3000

# OpenAI

OPENAI_API_KEY=

# Required for real OpenAI execution. The normal MVP configuration uses one
# global Responses API model across Analyze, Research, and Generation. Research
# also requires web_search and structured-output support. The generic
# application default is not a usable OpenAI model identifier.
LLM_MODEL=gpt-5.6-terra

# Global provider timeout. Override only when the deployment requires a
# different ceiling; retries remain disabled by the provider adapter.
LLM_TIMEOUT_MS=90000

# Optional generic LLM override
# LLM_MAX_TOKENS=

# Optional Analyze workflow overrides
# ANALYZE_RUN_STALE_AFTER_MS=
